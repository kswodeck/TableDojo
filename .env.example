# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- API (apps/api) --------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tabledojo

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Public base URL of the web app; used to build password-reset links.
WEB_ORIGIN=http://localhost:3000

# Optional error monitoring. Leave blank to disable.
SENTRY_DSN=

# Optional SMTP transport for password-reset and contact email.
# With these blank, the API logs the message instead of sending it.
SMTP_URL=
MAIL_FROM="Table Dojo <no-reply@tabledojo.com>"
CONTACT_TO=

# --- Web (apps/web) --------------------------------------------------------
# Browser-visible API base URL.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side API base URL, used during SSR (may differ inside Docker/compose).
API_INTERNAL_URL=http://localhost:5000
